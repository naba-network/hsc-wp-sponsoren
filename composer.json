{
    "name": "hsc-hohenems/hsc-sponsoren",
    "description": "Sponsors and partners of the HSC website as a single source of truth.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": { "php": ">=8.0",
        "yahnis-elsts/plugin-update-checker": "^5.6" },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "php-parallel-lint/php-parallel-lint": "^1.4"
    },
    "config": {
        "platform": { "php": "8.1.0" },
        "autoloader-suffix": "HscSponsoren",
        "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true }
    },
    "scripts": {
        "lint": [
            "parallel-lint hsc-sponsoren.php includes bin tests",
            "phpcs"
        ],
        "test": "phpunit"
    }
}
